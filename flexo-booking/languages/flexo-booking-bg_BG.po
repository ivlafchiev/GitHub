#: includes/class-frontend.php:169 includes/class-settings.php:813
msgid "Payment"
msgstr "Плащане"

#: includes/class-settings.php:816
msgid "Included in the booking total"
msgstr "Включен в общата сума на резервацията"

#: includes/class-settings.php:817
msgid ""
"Paid separately at the property (shown to the guest, not part of the total)"
msgstr ""
"Плаща се отделно на място (показва се на госта, но не е част от общата сума)"

#: includes/admin/class-wizard.php:70 includes/class-settings.php:825
