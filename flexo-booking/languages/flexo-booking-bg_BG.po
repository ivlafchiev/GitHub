msgid "Payment deadline"
msgstr "Срок за плащане"

#: includes/admin/class-payments-admin.php:182
msgid "days after booking (or after you confirm a request)"
msgstr "дни след резервацията (или след като потвърдите заявка)"

#: includes/admin/class-payments-admin.php:185
msgid "Reminder"
msgstr "Напомняне"

#: includes/admin/class-payments-admin.php:186
